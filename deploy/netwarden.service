[Unit]
Description=NetWarden network health monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=netwarden
Group=netwarden
WorkingDirectory=/opt/netwarden
EnvironmentFile=/opt/netwarden/.env
ExecStart=/opt/netwarden/.venv/bin/netwarden run --config /opt/netwarden/config.yaml
Restart=on-failure
RestartSec=10
# Hardening: NetWarden only needs outbound network access and its own data directory.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/netwarden/data /opt/netwarden/reports /opt/netwarden/remediation_scripts
PrivateTmp=true
# Uncomment to allow the active DHCP probe to bind UDP/68 without running as root:
# AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW

[Install]
WantedBy=multi-user.target
